<!-- TELEGRAM CLICK TRACKING -->
<script>
function trackTelegramClick(event, position) {

    // Prevent immediate navigation
    event.preventDefault();

    // Save Telegram destination
    const telegramUrl = event.currentTarget.href;

    // Send Meta Custom Event
    if (typeof fbq === 'function') {

        fbq('trackCustom', 'TelegramButtonClick', {
            button_position: position
        });

        // Give Pixel time to send event
        setTimeout(function() {
            window.location.href = telegramUrl;
        }, 500);

    } else {

        // Open Telegram even if Pixel is unavailable
        window.location.href = telegramUrl;

    }
}
</script>

